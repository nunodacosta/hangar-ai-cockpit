<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    Identidade atribuída pelo Partner Center em "Gestor de produtos >
    Identidade do produto". O Publisher tem de coincidir exatamente com o
    certificado com que a Microsoft assina o pacote.
    Podem ser substituídos no build por MSIX_NAME / MSIX_PUBLISHER.
  -->
  <Identity
    Name="AlexandredaCosta.HangarAICockpit"
    Publisher="CN=A9DA431F-AED2-4437-AE71-F63E7D8FAED3"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Hangar - AI Cockpit</DisplayName>
    <PublisherDisplayName>Alexandre da Costa</PublisherDisplayName>
    <Description>Gestor local de agentes e modelos de IA com consola integrada</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-PT" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Hangar" Executable="Hangar - AI Cockpit.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Hangar - AI Cockpit"
        Description="Gestor local de agentes e modelos de IA com consola integrada"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#111C30" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
